    {
      "parameters": {
        "promptType": "define",
        "text": "=cadidate resume: {{ $('Extract from File').item.json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=# Overview\n\nYou are an expert technical recruiter specializing in AI, automation, software, and technical roles. You have been provided with a job description and a candidate resume. Your task is to evaluate how well the candidate matches the role by analyzing technical skills, experience, projects, and overall job fit. Generate a structured screening report using only the information available in the resume and job description, avoiding assumptions or unsupported conclusions. ## Output dont take locations into consideration while taking decisions\n\nCandidate Strengths:\nList the top strengths or relevant qualifications the candidate brings.\nBe specific.\n\nCandidate Weaknesses:\nList areas where the candidate is lacking or mismatched based on the job description.\n\nRisk Factor:\n- Assign a risk score (Low / Medium / High)\n- Explain the worst-case scenario if this candidate is hired.\n\nReward Factor:\n- Assign a reward score (Low / Medium / High)\n- Describe the best-case scenario and value this candidate could unlock.\n- Determine if the candidate appears to be a short-term or long-term fit.\n\nOverall Fit Rating (0–10):\nAssign a number between 0 (terrible match) and 10 (perfect match).\nDo not use decimals. you can give 0 also if there is nothing matching this wont be send to the candidate \n\nJustification for Rating:\nExplain clearly why this candidate received that score.\nReference resume content and job description alignment.\n\nSkill Gap Analysis (Only if Overall Fit Rating < 5) wirte this in short to be sent to the candidate along with the mail:\n- List missing skills\n- Mention important technologies/tools absent\n- Suggest areas for improvement\n\nInterview Questions:\nGenerate 5 questions based on the candidate’s resume to validate:\n1. Projects\n2. Technical skills\n3. Experience\n4. Tools used\n5. Problem-solving ability\n\n## Job Description {{ $json.text }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1488,
        -80
      ],
      "id": "2f56645f-951e-485c-8999-1d077c6449be",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"candidate_strengths\": {\n      \"type\": \"array\",\n      \"description\": \"Top strengths or relevant qualifications of the candidate.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n\n    \"candidate_weaknesses\": {\n      \"type\": \"array\",\n      \"description\": \"Areas where candidate is lacking or mismatched.\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n\n    \"risk_factor\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"score\": {\n          \"type\": \"string\",\n          \"enum\": [\"Low\", \"Medium\", \"High\"]\n        },\n        \"worst_case\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"score\",\n        \"worst_case\"\n      ]\n    },\n\n    \"reward_factor\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"score\": {\n          \"type\": \"string\",\n          \"enum\": [\"Low\", \"Medium\", \"High\"]\n        },\n\n        \"best_case\": {\n          \"type\": \"string\"\n        },\n\n        \"fit_type\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"Short-term\",\n            \"Long-term\"\n          ]\n        }\n      },\n\n      \"required\": [\n        \"score\",\n        \"best_case\",\n        \"fit_type\"\n      ]\n    },\n\n    \"overall_fit_rating\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 10,\n      \"description\": \"Overall fit score from 0 to 10 without decimals.\"\n    },\n\n    \"justification_for_rating\": {\n      \"type\": \"string\"\n    },\n\n    \"skill_gap_analysis\": {\n      \"type\": \"object\",\n      \"description\": \"Generate ONLY when overall_fit_rating is LESS than 5\",\n\n      \"properties\": {\n\n        \"missing_skills\": {\n          \"type\": \"array\",\n          \"description\": \"List important required skills the candidate does not have.\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n\n        \"missing_tools\": {\n          \"type\": \"array\",\n          \"description\": \"List missing tools, platforms, IDEs, or technologies.\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n\n        \"improvement_areas\": {\n          \"type\": \"array\",\n\n          \"description\": \"Generate actionable learning suggestions in sentence format like 'Learn embedded C/C++ programming', 'Acquire microcontroller and firmware development skills', 'Understand PCB design basics'\",\n\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n\n      },\n\n      \"required\": [\n        \"missing_skills\",\n        \"missing_tools\",\n        \"improvement_areas\"\n      ]\n    },\n\n    \"interview_questions\": {\n      \"type\": \"array\",\n\n      \"description\": \"Generate EXACTLY 5 questions ONLY when overall_fit_rating is GREATER than or EQUAL to 5\",\n\n      \"minItems\": 5,\n      \"maxItems\": 5,\n\n      \"items\": {\n\n        \"type\": \"object\",\n\n        \"properties\": {\n\n          \"category\": {\n            \"type\": \"string\",\n\n            \"enum\": [\n              \"Projects\",\n              \"Technical Skills\",\n              \"Experience\",\n              \"Tools\",\n              \"Problem Solving\"\n            ]\n          },\n\n          \"question\": {\n            \"type\": \"string\"\n          }\n\n        },\n\n        \"required\": [\n          \"category\",\n          \"question\"\n        ]\n      }\n    }\n\n  },\n\n  \"required\": [\n    \"candidate_strengths\",\n    \"candidate_weaknesses\",\n    \"risk_factor\",\n    \"reward_factor\",\n    \"overall_fit_rating\",\n    \"justification_for_rating\"\n  ]\n}"
      },
